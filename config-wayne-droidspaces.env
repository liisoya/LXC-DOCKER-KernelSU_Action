# Wayne (小米6X) Droidspaces 非 GKI 内核编译配置
# 仅供 .github/workflows/build-wayne-droidspaces.yml 使用

# 内核源码地址
KERNEL_SOURCE=https://github.com/LKGeek-Team/LKGeek_sdm660

# 内核源码分支
KERNEL_SOURCE_BRANCH=Sukisu

# 是否启用 KernelSU(ReSukiSU)
# 工具链已切换为 clang20(vDSO 问题的真凶), ReSukiSU 重新启用
# 若本轮仍卡开机, 再改回 false 做隔离验证
ENABLE_KSU=true

# 内核编译配置（wayne = 小米6X，MIUI 适配用 perf 树）
KERNEL_CONFIG=wayne-perf_defconfig

# 内核打包名字前缀，workflow 会自动追加日期后缀
KERNEL_ZIP_NAME=wayne_droidspaces_4.19

# 选择要打包的内核镜像文件
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要 LLVM=1 LLVM_IAS=1 参数
LLVM_CONFIG=y

# 是否写入 Droidspaces 非 GKI 配置清单（Kernel-Configuration.md 步骤 1）
ENABLE_DROIDSPACES=true

# 是否应用 Droidspaces 非 GKI 补丁（patches/ 目录，幂等应用）
ENABLE_DROIDSPACES_PATCH=true

# 是否追加可选的 UFW/Fail2ban 防火墙配置（步骤 2，默认关闭）
ENABLE_UFW_FAIL2BAN=false

# 是否开启 kvm（一般用不到）
ENABLE_KVM=false

# 是否需要 dtbo
NEED_DTBO=false
